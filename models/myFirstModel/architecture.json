{
  "input_features": 2043,
  "output_features": 2,
  "layers": [
    {
      "type": "dense",
      "units": 512,
      "activation": "relu",
      "name": "temporal_processing"
    },
    {
      "type": "dropout",
      "rate": 0.3
    },
    {
      "type": "dense",
      "units": 256,
      "activation": "relu",
      "name": "pattern_processing"
    },
    {
      "type": "dropout",
      "rate": 0.3
    },
    {
      "type": "dense",
      "units": 128,
      "activation": "relu",
      "name": "feature_fusion"
    },
    {
      "type": "dropout",
      "rate": 0.3
    },
    {
      "type": "dense",
      "units": 64,
      "activation": "relu",
      "name": "decision_processing"
    },
    {
      "type": "dropout",
      "rate": 0.2
    },
    {
      "type": "dense",
      "units": 32,
      "activation": "relu",
      "name": "final_processing"
    },
    {
      "type": "dense",
      "units": 2,
      "activation": "linear",
      "name": "trading_outcomes"
    }
  ],
  "optimizer": {
    "type": "adam",
    "learning_rate": 0.001
  },
  "loss": "meanSquaredError",
  "metrics": [
    "mae"
  ]
}